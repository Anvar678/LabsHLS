# Переменные варианта. Скопируйте в .env; значения задают задания работ.
#
# COMPOSE_FILE перечисляет базовый файл и по одному файлу на ось, разделитель —
# двоеточие. В работе 1 в нём только compose.yaml; работа, которая фиксирует
# ось, дописывает в конец файл своего значения:
#   ЛР3 compose.s3-<seaweedfs|garage>.yaml
#   ЛР4 compose.engine-<trino|starrocks|duckdb>.yaml
#   ЛР5 compose.bi-<metabase|superset|datalens>.yaml
#   ЛР6 compose.broker-<kafka|redpanda>.yaml
#   ЛР7 compose.orchestrator-<airflow|dagster>.yaml
#   ЛР8 compose.stream-<flink|spark-ss>.yaml
# Два файла одной оси Compose молча сливает в один сервис с чужими настройками.
COMPOSE_FILE=compose.yaml

# Значения осей варианта — их читают программы студента; набор сервисов
# варианта задаёт COMPOSE_FILE. VARIANT и SOURCE задаёт работа 1, SERDE —
# работа 2, остальные — работа, которая фиксирует ось.
VARIANT=
SOURCE=
SERDE=
S3=
ENGINE=
BI=
BROKER=
ORCHESTRATOR=
STREAM=

# Режим службы сборщика: record (запись) с работы 1, produce (запись и отправка
# в брокер) с работы 6. Разовые режимы — `docker compose run --rm collector <режим>`.
COLLECTOR_MODE=record

# Источник: фильтр потока из задания варианта (подмножество проектов, регион;
# пусто — без фильтра) и предел объёма слоя сырых данных в гигабайтах.
# Предел рассчитан так, чтобы вмещать не меньше восьми недель потока варианта
# после фильтра и сжатия (методические указания, паспорт источника).
SOURCE_FILTER=
COLLECTOR_RAW_LIMIT_GB=20

# Адреса и ключи стенда. Сборщику, `spark`, `duckdb` и потоковому заданию
# Spark виден весь .env; движку `engine` и оркестратору — только переменные
# S3_*, CATALOG_* и WAREHOUSE_*: правка остальных строк их не перезапускает.
#
# Доступ к объектному хранилищу (одинаков у обоих значений оси s3). Garage
# берёт ключ отсюда, SeaweedFS — из services/seaweedfs/s3.json: при смене ключа
# правятся оба места.
S3_ENDPOINT=http://s3:9000
S3_REGION=stand
S3_ACCESS_KEY=studentaccess
S3_SECRET_KEY=studentsecretkey
S3_BUCKET=lake

# Каталог таблиц Iceberg.
CATALOG_URI=http://catalog:8181/catalog
CATALOG_WAREHOUSE=lake

# Аналитическое хранилище.
WAREHOUSE_HOST=warehouse
WAREHOUSE_USER=student
WAREHOUSE_PASSWORD=student
WAREHOUSE_DB=mart

# Брокер и реестр схем. Изнутри стенда брокер отвечает по broker:9092,
# программам на стенде вне контейнеров — по localhost:$PORT_BROKER.
BROKER_BOOTSTRAP=broker:9092
REGISTRY_URL=http://registry:8081

# Порты рабочей машины. Значения по умолчанию — штатные порты стенда; менять
# их нужно только если порт на рабочей машине уже занят.
#PORT_S3=9000
#PORT_S3_UI=9001
#PORT_CATALOG=8181
#PORT_WAREHOUSE_HTTP=8123
#PORT_WAREHOUSE_NATIVE=9002
#PORT_ENGINE=8080
#PORT_ENGINE_SQL=9030
#PORT_BROKER=9092
#PORT_REGISTRY=8081
#PORT_BI=8088
#PORT_ORCHESTRATOR=8082
#PORT_STREAM=8083
#PORT_COLLECTOR=9101
#PORT_SPARK_UI=4040

# Каталоги с кодом студента: программа сборщика, конвейеры оркестратора,
# задания движков и файлы подключений. Значения по умолчанию — каталоги стенда.
#COLLECTOR_SRC=./collector/src
#DAGS_DIR=./dags
#JOBS_DIR=./jobs
#CONF_DIR=./conf
